   "source": [
    "check_number, checknumber1 = map(int, input(\"Enter two numbers:\").split())\n",
    "def find_largest(num1, num2):\n",
    "    if num1 > num2:\n",
    "        return num1\n",
    "    else:\n",
    "        return num2\n",
    "largest = find_largest(check_number, checknumber1)\n",
    "print(\"The largest number is:\", largest)"
   ]
