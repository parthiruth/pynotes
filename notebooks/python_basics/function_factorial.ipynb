   ],
   "source": [
    "def factorial_check(num):\n",
    "    if num == 0:\n",
    "        return 1\n",
    "    else:\n",
    "        return num * factorial_check(num-1)\n",
    "        \n",
    "result = factorial_check(int(input(\"Enter a number:\")))\n",
    "print(\"The factorial is:\", result)"
   ]
