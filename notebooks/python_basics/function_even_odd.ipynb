    "def even_odd(num):\n",
    "    if num % 2 == 0:\n",
    "        print(\"Even\")\n",
    "    else:\n",
    "        print(\"Odd\")\n",
    "result= int(input(\"Enter the number:\"))\n",
    "even_odd(result)"
